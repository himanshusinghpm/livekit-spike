# Supabase project settings -> Project Settings -> Data API
# The anon key is safe to expose to the browser (it is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Dodo Payments (server-side only — never prefix with NEXT_PUBLIC) ---
# Create an API key in Dodo -> Developers -> API Keys
DODO_API_KEY=your_dodo_api_key
# Signing secret from the endpoint created in Dodo -> Developers -> Webhooks
DODO_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Product IDs from Dodo -> Developers -> Products. These differ between test and
# live mode, so swap all four DODO_*_ID values together when you go live.
DODO_PRODUCT_BOUTIQUE_ID=your_boutique_product_id
DODO_PRODUCT_GROWTH_ID=your_growth_product_id
# Test: https://test.dodopayments.com  |  Live: https://live.dodopayments.com
DODO_API_BASE=https://test.dodopayments.com
# Client-side hosted checkout links (public by design). Point at your LIVE
# checkout links when cutting over from test to live.
NEXT_PUBLIC_DODO_BOUTIQUE_URL=https://test.checkout.dodopayments.com/buy/your_boutique_product_id
NEXT_PUBLIC_DODO_GROWTH_URL=https://test.checkout.dodopayments.com/buy/your_growth_product_id
