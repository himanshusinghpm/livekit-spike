{
  "name": "LiveKit Telemetry",
  "version": "1.1.0",
  "description": "Zero-friction, real-time cross-platform telemetry layer for creators and agencies.",
  "manifest_version": 3,
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.kick.com/*",
    "*://*.youtube.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.kick.com/*"],
      "js": ["livekit-scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}