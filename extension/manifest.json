{
  "name": "LiveKit Background Worker",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "*://*.kick.com/*",
    "*://*.youtube.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}

